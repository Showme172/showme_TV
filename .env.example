# انسخ هاد الملف وسمّيه .env وحط فيه مفاتيح مشروع Supabase تبعك
# (لاقيهم بـ Settings → API جوا مشروعك على supabase.com)
# هلق مشروع واحد بس لكل شي (نفس مشروع لوحة العملاء Panel.html)

VITE_SUPABASE_URL=https://egbzsmwctoghvubahxvd.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# مفتاح Stripe العلني (Publishable key) — يبدأ بـ pk_ ، آمن يكون بالواجهة
# لاقيه بـ Stripe Dashboard → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
